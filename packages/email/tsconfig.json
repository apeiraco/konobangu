{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "outDir": "dist-tsc/lib",
    "tsBuildInfoFile": "dist-tsc/lib.tsbuildinfo",
    "types": ["react"]
  },
  "include": [
    "./*.ts",
    "./*.tsx",
    "./templates/**/*.ts",
    "./templates/**/*.tsx"
  ],
  "exclude": ["node_modules", "dist", "dist-tsc"]
}
