{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "paths": {
      "*": ["./*"]
    },
    "typeRoots": ["./node_modules/@types", "./node_modules"]
  },
  "include": ["./main.ts"],
  "exclude": ["node_modules"]
}
