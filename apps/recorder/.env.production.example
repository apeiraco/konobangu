SERVER__HOST="konobangu.example"
DATABASE__URL_FILE="/run/secrets/database_uri"
DATABASE__MIGRATION__AUTO_RUN=true
# Optional separate owner credential for managed migrations:
# DATABASE__MIGRATION__URL_FILE="/run/secrets/migration_uri"
# DATABASE__MIGRATION__LEGACY_OIDC_ISSUER="https://idp.example/"
AUTH__PROVIDER__TYPE="oidc"
AUTH__SESSION__PUBLIC_URL="https://konobangu.example/"
AUTH__SESSION__COOKIE_SECURE=true
AUTH__PROVIDER__ISSUER="https://idp.example/"
AUTH__PROVIDER__AUDIENCE="konobangu"
AUTH__PROVIDER__CLIENT_ID="konobangu"
AUTH__PROVIDER__CLIENT_SECRET_FILE="/run/secrets/oidc_client_secret"
# For explicit Basic mode replace OIDC fields with:
# AUTH__PROVIDER__TYPE="basic"
# AUTH__PROVIDER__USERNAME="administrator"
# AUTH__PROVIDER__PASSWORD_FILE="/run/secrets/basic_password"
# File contents are literal UTF-8; create URI files without a trailing newline.
# Do not also set the corresponding ordinary canonical value (even empty).
# See docs/en/015-MEDIA-AND-CONFIGURATION.md for Compose secret mounts.
# See docs/en/013-AUTHENTICATION-DECISION.md before migrating existing data.
# Automatic media inherits JXL + WebP; a trimmed build inherits WebP only.
# Optional explicit policy (an empty list disables automatic derivatives):
# MEDIA__AUTO_OPTIMIZE_FORMATS=["image/webp"]
