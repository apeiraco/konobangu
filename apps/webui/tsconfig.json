{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "composite": true,
    "jsx": "preserve",
    "jsxImportSource": "react",
    "lib": [
      "DOM",
      "ES2024",
      "ESNext.Temporal",
      "DOM.AsyncIterable",
      "DOM.Iterable",
      "ESNext.Disposable"
    ],
    "paths": {
      "@/*": ["./src/*"]
    },
    "outDir": "dist-tsc/app",
    "tsBuildInfoFile": "dist-tsc/app.tsbuildinfo",
    "types": ["react"]
  },
  "include": ["src"],
  "references": [
    {
      "path": "../../apps/recorder"
    },
    {
      "path": "./tsconfig.scripts.json"
    }
  ],
  "exclude": ["node_modules", "dist", "dist-tsc"]
}
