{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"rootDir": ".",
		"composite": true,
		"jsx": "preserve",
		"jsxImportSource": "react",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": false,
		"emitDeclarationOnly": false,
		"verbatimModuleSyntax": false,
		"isolatedModules": true,
		"skipLibCheck": true,
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src"],
	"references": [
		{
			"path": "../../apps/recorder"
		}
	]
}
