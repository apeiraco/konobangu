{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "outDir": "dist-tsc/scripts",
    "tsBuildInfoFile": "dist-tsc/scripts.tsbuildinfo",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "erasableSyntaxOnly": true
  },
  "include": ["**/*.mts"],
  "exclude": ["node_modules", "dist-tsc"]
}
